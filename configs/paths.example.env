# Copy to .env and adjust model paths and endpoints for your environment.

# Workspace & output directories (resolved relative to repository root by default)
MCARE_ROOT=.
MCARE_DATA_DIR=./data
MCARE_EXP_DIR=./outputs

# Policy backbone & evaluation text-metric model
MCARE_BASE_MODEL=Qwen/Qwen3.5-9B
MCARE_ROBERTA_DIR=roberta-large

# ---------------------------------------------------------------------------
# Offline training annotator and reward models
# ---------------------------------------------------------------------------
MCARE_TRAIN_ANNOTATOR_MODEL=Qwen/Qwen3.8-27B
MCARE_TRAIN_ANNOTATOR_URL=http://127.0.0.1:8078/v1
MCARE_TRAIN_ANNOTATOR_NAME=qwen
MCARE_TRAIN_ANNOTATOR_API_KEY=EMPTY
MCARE_TRAIN_WORKERS=16
MCARE_TRAIN_SUPPORT_RM=./outputs/models/support_rm
MCARE_TRAIN_HELPFULNESS_CRITIC=./outputs/models/helpsteer2_critic.pkl

# ---------------------------------------------------------------------------
# Evaluation judge and automatic scoring models
# ---------------------------------------------------------------------------
MCARE_EVAL_JUDGE_MODEL=google/gemma-4-31b-it
MCARE_EVAL_JUDGE_URL=http://127.0.0.1:8077/v1
MCARE_EVAL_JUDGE_NAME=gemma
MCARE_EVAL_JUDGE_API_KEY=EMPTY
MCARE_EVAL_WORKERS=16
MCARE_EVAL_ARMORM_MODEL=RLHFlow/ArmoRM-Llama3-8B-v0.1
MCARE_EVAL_ESCRANK_BASE=internlm/internlm2-chat-7b
MCARE_EVAL_ESCRANK_ADAPTER=./models/evaluators/ESC-RANK
MCARE_EVAL_ESC_SCORE=./external/ESC-Eval/score.py

# Stage checkpoints (populated during training)
MCARE_STAGE1_ADAPTER=./outputs/stage1/pi1_s42/final
MCARE_SPECIALIST_ADAPTER=./outputs/specialist/piE_s42/final
MCARE_FINAL_ADAPTER=./outputs/stage2/MCARE_s42/final
